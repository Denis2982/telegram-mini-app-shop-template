# --- Telegram ---
BOT_TOKEN=
BOT_USERNAME=my_shop_bot
TELEGRAM_MINI_APP_URL=https://shop.example.com
TELEGRAM_WEBHOOK_SECRET=
SUPPORT_USERNAME=my_support

# --- Служебные идентификаторы ---
ADMIN_CHAT_ID=
# Telegram ID сотрудников с доступом к /admin и кнопкам (через запятую)
ADMIN_IDS=
# Ключ для веб-админки /admin (в демо без BOT_TOKEN по умолчанию "admin")
ADMIN_API_KEY=

# --- База данных (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Docker Compose requires a unique password; use a random hex value (see docs/DEPLOYMENT.md).
POSTGRES_PASSWORD=
# Для Vercel подключите Blob Store к проекту (OIDC). Вне Vercel можно задать read-write token.
BLOB_READ_WRITE_TOKEN=

# --- Магазин и валюта ---
CURRENCY_CODE=RUB
CURRENCY_SYMBOL=₽
STORE_NAME="Commercial Shop"
# Supported: ru, en, uk
DEFAULT_LOCALE=ru
# Enable only in an isolated public demo environment.
ENABLE_DEMO_MODE=false
SEED_DEMO_DATA=true

# --- Доставка ---
DELIVERY_COURIER_FEE=300
DELIVERY_POST_FEE=200
FREE_DELIVERY_FROM=5000
# Пункты самовывоза через ; Оставьте пустым, если самовывоза нет.
PICKUP_POINTS=

# --- Платежные провайдеры ---
PAYMENT_PROVIDER_TOKEN=
# Telegram Stars предназначены только для цифровых товаров; для этого физического магазина — false.
TELEGRAM_STARS_ENABLED=false
# Сколько Stars за 1 единицу валюты магазина (только для цифровых товаров)
STARS_PER_UNIT=0.5
MANUAL_PAYMENT_DETAILS=
