# --- Telegram ---
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ
BOT_USERNAME=my_shop_bot
TELEGRAM_MINI_APP_URL=https://shop.example.com
TELEGRAM_WEBHOOK_SECRET=change-me
SUPPORT_USERNAME=my_support

# --- Служебные идентификаторы ---
ADMIN_CHAT_ID=-100123456789
# Telegram ID сотрудников с доступом к /admin и кнопкам (через запятую)
ADMIN_IDS=
# Ключ для веб-админки /admin (в демо без BOT_TOKEN по умолчанию "admin")
ADMIN_API_KEY=change-me

# --- База данных (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Для Vercel: подключите Blob Store, чтобы создать этот токен автоматически
BLOB_READ_WRITE_TOKEN=

# --- Магазин и валюта ---
CURRENCY_CODE=RUB
CURRENCY_SYMBOL=₽
STORE_NAME="Commercial Shop"
DEFAULT_LOCALE=ru
SEED_DEMO_DATA=true

# --- Доставка ---
DELIVERY_COURIER_FEE=300
DELIVERY_POST_FEE=200
FREE_DELIVERY_FROM=5000
# Пункты самовывоза через ; 
PICKUP_POINTS="ул. Тверская, 1 (10:00–21:00);ТЦ Галерея, 2 этаж (10:00–22:00)"

# --- Платежные провайдеры ---
PAYMENT_PROVIDER_TOKEN=
TELEGRAM_STARS_ENABLED=true
# Сколько Stars за 1 единицу валюты магазина
STARS_PER_UNIT=0.5
MANUAL_PAYMENT_DETAILS="Сбербанк: 0000 0000 0000 0000\nПолучатель: Иван И.\nВ комментарии укажите номер заказа"
